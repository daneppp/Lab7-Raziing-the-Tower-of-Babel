# Wrapping preferences
#DP
max_general_line_length = 80;
#BAD: Console.WriteLine("This is an example of a C# statement that exceeds eighty characters on a single line of code.");
 #GOOD: Console.WriteLine("This is an example of a C# statement that exceeds 
 #                        eighty characters on a single line of code.");
#DP
max_method_signature_line_length = 60;
