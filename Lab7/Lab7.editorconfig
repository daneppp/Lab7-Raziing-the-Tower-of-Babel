#### C# Coding Conventions ####

# var preferences

# Expression-bodied members


# Pattern matching preferences


# Null-checking preferences


# Modifier preferences

# Code-block preferences
# SAM
csharp_prefer_braces = true:warning

# Expression-level preferences

# 'using' directive preferences


# New line preferences

#### C# Formatting Rules ####

# New line preferences

# Indentation preferences
#RA
csharp_indent_block_contents = true
#RA
csharp_indent_braces = false
#RA 
csharp_indent_case_contents = true
#RA
csharp_indent_switch_labels = true


# Space preferences

# Wrapping preferences

#### Naming styles ####

# Naming rules
# SAM
dotnet_naming_rule.types_methods_pascal.severity = warning
# SAM
dotnet_naming_rule.types_methods_pascal.symbols = types_methods
# SAM
dotnet_naming_rule.types_methods_pascal.style = pascal_case
# SAM
dotnet_naming_rule.locals_camel.severity = warning
# SAM
dotnet_naming_rule.locals_camel.symbols = locals
# SAM
dotnet_naming_rule.locals_camel.style = camel_case
# SAM
dotnet_naming_rule.private_fields_underscore.severity = warning
# SAM
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
# SAM
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
# SAM
dotnet_naming_rule.interfaces_i.severity = warning
# SAM
dotnet_naming_rule.interfaces_i.symbols = interfaces
# SAM
dotnet_naming_rule.interfaces_i.style = i_prefix


# Symbol specifications
# SAM
dotnet_naming_symbols.types_methods.applicable_kinds = class, struct, interface, enum, method, property
# SAM
dotnet_naming_symbols.locals.applicable_kinds = local, parameter
# SAM
dotnet_naming_symbols.private_fields.applicable_kinds = field
# SAM
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
# SAM
dotnet_naming_symbols.interfaces.applicable_kinds = interface


# Naming styles
# SAM
dotnet_naming_style.pascal_case.capitalization = pascal_case
# SAM
dotnet_naming_style.camel_case.capitalization = camel_case
# SAM
dotnet_naming_style.underscore_camel.capitalization = camel_case
# SAM
dotnet_naming_style.underscore_camel.required_prefix = _
# SAM
dotnet_naming_style.i_prefix.capitalization = pascal_case
# SAM
dotnet_naming_style.i_prefix.required_prefix = I